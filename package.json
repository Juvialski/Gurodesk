    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pizzip": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@xmldom/xmldom": "^0.8.13",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
