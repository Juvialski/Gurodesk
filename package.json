{
  "name": "gurodesk",
  "private": true,
  "version": "0.3.8",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "curriculum:validate": "node scripts/validate-curriculum.mjs data/curriculum/*.json",
    "curriculum:generate:g7math": "node scripts/generate-curriculum-sql.mjs data/curriculum/matatag-grade7-mathematics.json supabase/seeds/matatag-grade7-mathematics.sql",
    "validate:phase2": "node scripts/check-phase2.mjs",
    "validate:phase3": "node scripts/check-phase3.mjs",
    "validate:byok": "node scripts/check-byok.mjs",
    "validate:phase35": "node scripts/check-phase35.mjs",
    "validate:phase351": "node scripts/check-phase351.mjs",
    "validate:phase352": "node scripts/check-phase352.mjs",
    "validate:phase353": "node scripts/check-phase353.mjs",
    "validate:phase36": "node scripts/check-phase36.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0",
    "docx": "^9.5.1",
    "jspdf": "^3.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2"
  }
}
