{
  "name": "gurodesk",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "prebuild": "node scripts/apply-school-district-overlay.mjs",
    "build": "tsc --noEmit && vite build",
    "prebuild:bundle": "node scripts/apply-school-district-overlay.mjs",
    "build:bundle": "vite build",
    "typecheck": "tsc --noEmit --pretty false",
    "typecheck:tests": "tsc -p tsconfig.tests.json --noEmit --pretty false",
    "typecheck:e2e": "tsc -p tsconfig.e2e.json --noEmit --pretty false",
    "preview": "vite preview --host 0.0.0.0",
    "curriculum:catalog:snapshot": "node scripts/curriculum/export-official-catalog.mjs",
    "curriculum:validate": "node scripts/validate-curriculum.mjs data/curriculum/official/*.json && node scripts/validate-official-curriculum-coverage.mjs",
    "curriculum:verify:sources": "node scripts/verify-official-curriculum-sources.mjs",
    "curriculum:generate:files": "node scripts/generate-all-curriculum-sql.mjs data/curriculum/official supabase/seeds/generated",
    "curriculum:generate:bundle": "node scripts/generate-official-curriculum-bundle.mjs data/curriculum/official supabase/seeds/official-curriculum-complete.sql",
    "curriculum:generate:standards-migration": "node scripts/curriculum/generate-verified-standards-migration.mjs data/curriculum/official supabase/migrations/202608130038_verified_curriculum_standards_expansion.sql",
    "curriculum:check:standards-migration": "node scripts/check-verified-standards-migration.mjs",
    "curriculum:check:bundle": "node scripts/check-official-curriculum-bundle.mjs",
    "curriculum:generate:all": "npm run curriculum:generate:bundle",
    "validate:phase2": "node scripts/check-phase2.mjs",
    "validate:phase3": "node scripts/check-phase3.mjs",
    "validate:byok": "node scripts/check-byok.mjs",
    "validate:phase35": "node scripts/check-phase35.mjs",
    "validate:phase351": "node scripts/check-phase351.mjs",
    "validate:phase352": "node scripts/check-phase352.mjs",
    "validate:phase353": "node scripts/check-phase353.mjs",
    "validate:phase36": "node scripts/check-phase36.mjs",
    "validate:phase361": "node scripts/check-phase361.mjs",
    "validate:phase362": "node scripts/check-phase362.mjs",
    "validate:phase363": "node scripts/check-phase363.mjs",
    "validate:phase37": "node scripts/check-phase37.mjs",
    "validate:phase4": "node scripts/check-phase4.mjs",
    "validate:phase41": "node scripts/check-phase41.mjs",
    "validate:phase42": "node scripts/check-phase42.mjs",
    "validate:phase43": "node scripts/check-phase43.mjs",
    "validate:phase50": "node scripts/check-phase50.mjs",
    "validate:phase51": "node scripts/check-phase51.mjs",
    "validate:phase52": "node scripts/check-phase52.mjs",
    "validate:phase53": "node scripts/check-phase53.mjs && node scripts/check-phase53-security.mjs",
    "validate:phase44": "node scripts/check-phase44-domain.mjs && node scripts/check-phase44-ai-editor.mjs",
    "validate:phase54": "node scripts/check-phase54.mjs",
    "validate:all": "node scripts/run-existing-validators.mjs",
    "validate:schools": "node scripts/check-school-directory-contract.mjs && node scripts/check-school-district-contract.mjs && node scripts/schools/validate-school-directory.mjs data/schools/philippine-schools.sample.json && node scripts/schools/validate-district-candidates.mjs data/schools/district-candidates/camarines-norte.json",
    "schools:import:nid": "node scripts/schools/import-deped-nid.mjs",
    "schools:sync:nid": "node scripts/schools/import-deped-nid.mjs --sync",
    "test": "npm run test:unit",
    "test:unit": "vitest run tests/unit",
    "pretest:integration": "vitest run tests/diagnostics/standard-assessment-roundtrip.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:db": "bash scripts/test-db-migrations.sh --all",
    "test:db:fresh": "bash scripts/test-db-migrations.sh --fresh",
    "test:db:upgrade": "bash scripts/test-db-migrations.sh --upgrade",
    "test:e2e:prepare": "node scripts/prepare-e2e-user.mjs",
    "test:e2e": "playwright test",
    "pretest:ci": "node scripts/apply-school-district-overlay.mjs",
    "test:ci": "npm run validate:schools && npm run typecheck && npm run typecheck:tests && npm run typecheck:e2e && npm run validate:edge-functions && npm run validate:all && npm run test:unit && npm run build:bundle",
    "test:release": "bash scripts/test-release.sh",
    "validate:phase6": "node scripts/check-phase6-curriculum.mjs && node scripts/check-phase6-custom-curriculum.mjs",
    "validate:phase6:curriculum": "node scripts/check-phase6-curriculum.mjs",
    "validate:phase6:custom": "node scripts/check-phase6-custom-curriculum.mjs",
    "validate:edge-functions": "node scripts/check-edge-function-source-contract.cjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.55.0",
    "docx": "^9.5.1",
    "docx-preview": "^0.4.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^0.468.0",
    "pizzip": "^3.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.8.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.10.13",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.0",
    "@xmldom/xmldom": "^0.8.13",
    "supabase": "^2.113.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
