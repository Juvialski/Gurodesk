      "text": "Nasusuri ang mga sanhi at epekto ng mga suliraning pangkapaligiran ng daigdig",
      "sourcePage": 68,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-1:item-3",
      "quarter": 1,
      "domain": "D03",
      "sortOrder": 3,
      "competencyCode": null,
      "text": "Natatalakay ang mga programa at inisyatiba upang mapangalagaan ang kapaligiran",
      "sourcePage": 69,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-1:item-4",
      "quarter": 1,
      "domain": "D04",
      "sortOrder": 4,
      "competencyCode": null,
      "text": "Nasusuri ang pagkakaiba ng top-down at bottom up approach sa pagharap sa suliraning pangkapaligiran",
      "sourcePage": 69,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-1:item-5",
      "quarter": 1,
      "domain": "D05",
      "sortOrder": 5,
      "competencyCode": null,
      "text": "Nasusuri ang kahalagahan ng Community-Based Disaster Risk Reduction and Management Approach sa pagtugon sa mga hamon at suliraning pangkapaligiran",
      "sourcePage": 69,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-2:item-1",
      "quarter": 2,
      "domain": "D06",
      "sortOrder": 1,
      "competencyCode": null,
      "text": "Naipaliliwanag ang kalagayang pang-ekonomiya ng bansa at ang mga isyung kinakaharap nito bunga ng globalisasyon",
      "sourcePage": 70,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-2:item-2",
      "quarter": 2,
      "domain": "D06",
      "sortOrder": 2,
      "competencyCode": null,
      "text": "Natataya ang implikasyon ng iba’t ibang suliranin sa paggawa, pamumuhay at sa pag-unlad ng ekonomiya ng bansa",
      "sourcePage": 70,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-2:item-3",
      "quarter": 2,
      "domain": "D07",
      "sortOrder": 3,
      "competencyCode": null,
      "text": "Nasusuri ang mga batas at saligan sa iba’t ibang tugon sa pagharap sa hamon at isyung pang-ekonomiya at pampolitika",
      "sourcePage": 70,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-1",
      "quarter": 3,
      "domain": "D08",
      "sortOrder": 1,
      "competencyCode": null,
      "text": "Natatalakay ang mga uri ng kasarian (gender) at sex",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-2",
      "quarter": 3,
      "domain": "D09",
      "sortOrder": 2,
      "competencyCode": null,
      "text": "Nasusuri ang gender roles sa Pilipinas at iba’t ibang panig ng daigdig",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-3",
      "quarter": 3,
      "domain": "D10",
      "sortOrder": 3,
      "competencyCode": null,
      "text": "Naipaliliwanag ang iba’t ibang salik na nagiging dahilan ng diskriminasyon sa kasarian, sa tahanan, paaralan, trabaho at komunidad",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-4",
      "quarter": 3,
      "domain": "D10",
      "sortOrder": 4,
      "competencyCode": null,
      "text": "Nasusuri ang iba’t ibang nararanasang karahasan ng lahat ng kasarian",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-5",
      "quarter": 3,
      "domain": "D10",
      "sortOrder": 5,
      "competencyCode": null,
      "text": "Naipahahayag ang pananaw tungkol sa nararanasang karahasan ng mga batang babae, kababaihan, at miyembro ng LGBTQIA+",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-6",
      "quarter": 3,
      "domain": "D11",
      "sortOrder": 6,
      "competencyCode": null,
      "text": "Nasusuri ang tugon ng iba’t ibang samahan (lokal at internasyonal) laban sa karahasan at diskriminasyon",
      "sourcePage": 71,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-3:item-7",
      "quarter": 3,
      "domain": "D12",
      "sortOrder": 7,
      "competencyCode": null,
      "text": "Napahahalagahan ang tugon ng pamahalaan at mamamayan ng Pilipinas sa mga isyu ng diskriminasyon at karahasan",
      "sourcePage": 72,
      "verificationStatus": "verified"
    },
    {
      "recordId": "revised-k10-grade-10-araling-panlipunan:period-4:item-1",
