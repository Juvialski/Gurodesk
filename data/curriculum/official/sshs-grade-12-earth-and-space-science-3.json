      "quarter": 1,
      "domain": "D04",
      "sortOrder": 9,
      "competencyCode": null,
      "text": "use satellite imagery (e.g. from PhilSA Space Data Dashboard, NASA Worldview or Copernicus Browser) to analyze land cover change, deforestation, or urban expansion in a Philippine locality over time; and",
      "sourcePage": 3,
      "verificationStatus": "verified"
