      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-13",
      "quarter": 1,
      "domain": "D06",
      "sortOrder": 13,
      "competencyCode": null,
      "text": "explain how enhanced greenhouse effect and human activities contribute to global warming and climate change;",
      "sourcePage": 4,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-14",
      "quarter": 1,
      "domain": "D06",
      "sortOrder": 14,
      "competencyCode": null,
      "text": "calculate personal or school-level carbon footprints and relate the results to national greenhouse gas emissions data;",
      "sourcePage": 4,
      "verificationStatus": "verified"
    },
