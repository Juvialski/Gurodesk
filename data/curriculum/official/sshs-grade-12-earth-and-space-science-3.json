      "quarter": 1,
      "domain": "D04",
      "sortOrder": 10,
      "competencyCode": null,
      "text": "evaluate how PhilSA and international space agencies use remote sensing data to monitor Philippine environment conditions and support disaster response.",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-11",
      "quarter": 1,
      "domain": "D05",
      "sortOrder": 11,
      "competencyCode": null,
      "text": "use satellite-derived datasets including temperature anomalies, sea level measurements, and atmospheric CO₂ to identify climate trends in the Philippines;",
      "sourcePage": 4,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-12",
      "quarter": 1,
      "domain": "D05",
      "sortOrder": 12,
      "competencyCode": null,
      "text": "use satellite and ocean observation data to analyze the sea level rise and its potential impacts on Philippine coastal communities;",
