      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-2",
      "quarter": 1,
      "domain": "D01",
      "sortOrder": 2,
      "competencyCode": null,
      "text": "use redshift data and cosmic microwave background evidence to evaluate the Big Bang model;",
      "sourcePage": 2,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-3",
      "quarter": 1,
      "domain": "D01",
      "sortOrder": 3,
      "competencyCode": null,
      "text": "analyze the timeline from the Big Bang to the formation of the first stars and galaxies;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-4",
      "quarter": 1,
      "domain": "D02",
      "sortOrder": 4,
      "competencyCode": null,
      "text": "analyze stellar spectra to classify stars using the Hertzsprung-Russel diagram;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-5",
      "quarter": 1,
      "domain": "D02",
      "sortOrder": 5,
      "competencyCode": null,
      "text": "apply Kepler’s laws to explain planetary orbital characteristics and habitability zones;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-6",
      "quarter": 1,
      "domain": "D03",
      "sortOrder": 6,
      "competencyCode": null,
      "text": "conduct investigation on the exoplanet detection methods and their relevance to astrobiology;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-7",
      "quarter": 1,
      "domain": "D03",
      "sortOrder": 7,
      "competencyCode": null,
      "text": "evaluate evidence from exoplanet research (e.g., atmospheric composition, temperature, and distance from a star) to assess conditions for extraterrestrial life;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
      "recordId": "sshs-grade-12-earth-and-space-science-3:period-1:item-8",
      "quarter": 1,
      "domain": "D04",
      "sortOrder": 8,
      "competencyCode": null,
      "text": "identify key space technologies for space exploration and Earth observation and their primary functions;",
      "sourcePage": 3,
      "verificationStatus": "verified"
    },
    {
