      "quarter": 4,
      "domain": "D04",
      "sortOrder": 4,
      "competencyCode": null,
      "text": "divide numbers with and without remainder: a. 2-to 3-digit numbers by 1-digit number without remainder, b. 2-digit numbers by 1-digit number with remainder, and c. 2-to 4-digit numbers by 10,100, and 1000.",
      "sourcePage": 38,
      "verificationStatus": "verified"
