      "quarter": 4,
      "domain": "D04",
      "sortOrder": 3,
      "competencyCode": null,
      "text": "find the missing number in a number sentence involving multiplication or division by 6, 7, 8, and 9 (e.g., __ x 7 = 56; 56 ÷ __ = 7).",
      "sourcePage": 38,
      "verificationStatus": "verified"
    },
    {
