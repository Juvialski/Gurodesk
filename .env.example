# Browser-safe Supabase values only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Render production values are the same browser-safe variables above.
# Do not add VITE_SUPABASE_SERVICE_ROLE, database passwords, Gemini keys,
# encryption keys, access tokens, or other privileged credentials here.

# Gemini is teacher BYOK (Bring Your Own Key).
# Do NOT put a Gemini API key in VITE_* variables or this file.
# Teachers connect their own key inside GuroDesk Settings → AI Assistant.
# The Supabase Edge Function encrypts the key before storage.
