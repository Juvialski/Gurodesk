# Browser-safe Supabase values only.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Never put GEMINI_API_KEY in a VITE_* variable.
# Add GEMINI_API_KEY as a Supabase Edge Function secret instead.

# Supabase Edge Function secrets (set server-side, never VITE_*):
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash-lite
